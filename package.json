{
  "name": "@void/lexis-editor",
  "version": "0.3.0",
  "type": "module",
  "files": [
    "dist",
    "types"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "import": "./dist/core.esm.js",
      "require": "./dist/core.cjs"
    },
    "./lexis-editor.css": "./dist/lexis-editor.css",
    "./lexis-content.css": "./dist/lexis-content.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint src/ test/",
    "format": "biome format src/ test/",
    "build:check": "biome check src/ test/",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@lexical/code": "^0.50.0",
    "@lexical/code-prism": "^0.50.0",
    "@lexical/extension": "^0.50.0",
    "@lexical/history": "^0.50.0",
    "@lexical/html": "^0.50.0",
    "@lexical/link": "^0.50.0",
    "@lexical/list": "^0.50.0",
    "@lexical/markdown": "^0.50.0",
    "@lexical/rich-text": "^0.50.0",
    "@lexical/selection": "^0.50.0",
    "@lexical/table": "^0.50.0",
    "@lexical/utils": "^0.50.0",
    "dompurify": "^3.4.15",
    "lexical": "^0.50.0",
    "marked": "^18.0.13",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "puppeteer-core": "^25.10.0",
    "sanitize.css": "^13.0.0",
    "vite": "^8.3.0"
  }
}
